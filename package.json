{
  "name": "moto-ledger",
  "scripts": {
    "build": "next build",
    "ci": "npm run build && npm run typecheck && npm run lint && npm run format:check && npm run test",
    "dev": "next dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "start": "next start",
    "test": "vitest run",
    "test:devnet": "vitest run tests/moto-ledger/devnet.integration.test.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:agente": "npm --prefix agente run typecheck",
    "migrate:customer-associations": "node --experimental-strip-types scripts/migrate-customer-associations.mjs"
  },
  "description": "Next.js, Tailwind, @solana/kit wallet + on-chain actions",
  "keywords": [
    "kit",
    "moto-ledger",
    "react",
    "solana-kit",
    "tailwind",
    "typescript"
  ],
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@solana-mobile/wallet-standard-mobile": "^0.7.0",
    "@solana-program/memo": "^0.15.0",
    "@solana-program/system": "^0.14.0",
    "@solana-program/token": "^0.17.0",
    "@solana-program/token-2022": "^0.20.1",
    "@solana/kit": "^8.6.0",
    "@solana/kit-plugin-rpc": "^0.19.0",
    "@solana/kit-plugin-wallet": "^0.20.0",
    "@solana/program-client-core": "^8.6.0",
    "@solana/react": "^8.6.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.7",
    "swr": "^2.5.1",
    "ws": "^8.18.3",
    "pinata": "^2.5.6",
    "qrcode.react": "^4.2.0"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "^1.5.6",
    "@codama/renderers-js": "^2.9.0",
    "@solana/surfpool": "^1.7.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@wallet-standard/wallet": "^1.1.0",
    "codama": "^1.11.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
